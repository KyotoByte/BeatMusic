<?xml version="1.0" encoding="UTF-8"?>
<!--
  BeatMusic lint policy. Every "error" lint reported for 1.0 build 2 was reviewed:
  crash-relevant ones were fixed in code (NewApi, StringFormatInvalid, MissingQuantity,
  UnsafeOptInUsageError). The three Compose rules below are style advice that fires on
  intentional code: StateFlow.value reads used only as a text field's initial value,
  a Flow mapped inside remember { }, and resources read through LocalContext (which
  only misses an in-app language switch until the screen recomposes). None can crash,
  so they stay visible as warnings rather than failing the build.
-->
<lint>
    <issue id="LocalContextGetResourceValueCall" severity="warning" />
    <issue id="StateFlowValueCalledInComposition" severity="warning" />
    <issue id="FlowOperatorInvokedInComposition" severity="warning" />
</lint>
